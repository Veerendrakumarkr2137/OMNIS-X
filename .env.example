# Set these environment variables in your terminal or hosting service.
# Local defaults need no environment configuration.
OMNIS_DEMO=1
# OMNIS_DEMO_DATASET=iiet
# OMNIS_DEMO_DATE=2026-11-25
# DATABASE_URL=sqlite:///C:/path/to/campus.db
# For Supabase, use the Session pooler host from the project Connect panel.
# DATABASE_URL=postgresql+psycopg://omnisx_app.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=ABSOLUTE_CA_PATH
# For a separate, empty non-demo database on HTTPS
# OMNIS_DEMO=0
# OMNIS_ADMIN=campus-admin
# OMNIS_ADMIN_PASSWORD=<a unique password of 12 or more characters>

# Optional isolated quick-demo workspace alongside production login:
# OMNIS_DEMO=0
# OMNIS_HOSTED_DEMO=0
# OMNIS_QUICK_DEMO=1
# OMNIS_DEMO_DATABASE_URL=postgresql+psycopg://DEDICATED_DEMO_USER:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# OMNIS_FRONTEND_ORIGINS=https://omnis-x-nine.vercel.app
# OMNIS_ALLOWED_HOSTS=omnis-x-backend.vercel.app
# The demo URL must use a separate initialized PostgreSQL database, never real student data.
