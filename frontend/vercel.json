{
  "rewrites": [
    {
      "source": "/demo/api/:path*",
      "destination": "https://omnis-x-backend.vercel.app/demo/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://omnis-x-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
